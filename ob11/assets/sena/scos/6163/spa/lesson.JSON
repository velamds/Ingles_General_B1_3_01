, {"type": "incorrect", "contents": [{"type": "text", "content": "wish"}]}, {"type": "post_question", "contents": {"type": "", "content": ""}}, {"type": "objective", "content": "secondary_3"}]}, {"responses": [{"correct": 0, "selected": 0, "id": 0, "_data": [{"type": "text", "content": ""}]}, {"correct": 1, "selected": 0, "id": 1, "_data": [{"type": "text", "content": "wish"}]}], "id": 4, "_data": [{"type": "question", "contents": [{"type": "text", "content": "I"}]}, {"type": "incorrect", "contents": [{"type": "text", "content": "hope"}]}, {"type": "post_question", "contents": {"type": "", "content": "things were different for me?"}}, {"type": "objective", "content": "secondary_3"}]}, {"responses": [{"correct": 0, "selected": 0, "id": 0, "_data": [{"type": "text", "content": ""}]}, {"correct": 1, "selected": 0, "id": 1, "_data": [{"type": "text", "content": "feel"}]}], "id": 5, "_data": [{"type": "question", "contents": [{"type": "text", "content": "<br/><br/> Don't you "}]}, {"type": "incorrect", "contents": [{"type": "text", "content": "look"}]}, {"type": "post_question", "contents": {"type": "", "content": "you need to meet more people like you?"}}, {"type": "objective", "content": "secondary_3"}]}], "template_override": 2, "id": 11, "_data": [{"type": "instructions", "contents": [{"type": "text", "content": "What is Peter supposed to say?"}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Activity 3"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"type": "learning_skills", "contents": [{"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Listening"}, {"type": "skill", "content": "Reading"}]}, {"type": "post_instructions", "contents": [{"type": "text", "content": "Instructions: \n<span class=\"bullet\">Listen to the dialogue again. </span> \n<span class=\"bullet\">Proofread the sentence. </span> \n<span class=\"bullet\">Click on the incorrect word. </span> \n<span class=\"bullet\">Type in the correct word to complete the sentence.</span>\n<span class=\"bullet\">Use capital letters where necessary. </span> \n"}, {"type": "audio", "content": "engenn8le01ob11re2aud01"}]}, {"type": "template_override", "content": 2}]}], "type": "scholar", "_data": [{"type": "lab_options", "contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}]}], "id": 0, "stimuli": [{"type": "welcome", "template_override": 1, "_data": [], "id": 0, "contents": [{}]}, {"contents": [{"type": "slideshow", "value": {"coverimg": "engenn8le01ob11re2img05.jpg", "audiosrc": "engenn8le01ob11re2aud01", "images": [{"time": "0", "image": "engenn8le01ob11re2img05.jpg", "text": "", "id": 0}, {"time": "100", "image": "engenn8le01ob11re2img05.jpg", "text": "<span class=\"strong\">Sally</span>:\t\tPeter! You look miserable! What happened?<br/><span class=\"strong\">Peter</span>:\t\tI finally gave Camilla a call. <br/><span class=\"strong\">Sally</span>:\t\tWow! That was a gutsy move. So, have you guys talked about going on a date?<br/><span class=\"strong\">Peter</span>:\t\tYou don't get it! She told me she already had a boyfriend. She's been with him for a couple of months already. She even said that he might be her soulmate.<br/><span class=\"strong\">Sally</span>:\t\tAw, I'm sorry, Peter. That must've felt like a shock.", "id": 1}, {"time": "22000", "image": "engenn8le01ob11re2img01.jpg", "text": "<span class=\"strong\">Peter</span>:\t\tI wish I wasn't so slow on the uptake! I should've realized she had a crush on me back in college!<br/><span class=\"strong\">Sally</span>:\t\tYou just take a while to understand what's going on sometimes, that's all.<br/><span class=\"strong\">Peter</span>:\t\tThings don't always seem obvious to me, you know that! I wish it wasn't always the case.<br/><span class=\"strong\">Sally</span>:\t\tI think you've always been more interested in your comics than real-life situations, perhaps. Don't you wish you were more grounded in reality?", "id": 2}, {"time": "44000", "image": "engenn8le01ob11re2img05.jpg", "text": "<span class=\"strong\">Peter</span>:\t\tSally, I'm a nerd. I've tried sounding like a more sensible kind of guy, but it has always failed to impress anyone. No matter how hard I try, I can never sound spontaneous when I'm out of my element. Don't you think I wish things were different for me?<br/><span class=\"strong\">Sally</span>:\t\tIn that case, I know what you're supposed to do. The girl of your dreams must be in a comic book store. You should keep your eyes open this time!", "id": 3}]}}], "template_override": 1, "title": "", "type": "audio", "id": 1, "_data": []}]}], "_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "The Big Argument"}, {"type": "unit_name", "content": "Oh, I Wish ..."}, {"type": "position", "content": 11}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 1}, {"type": "level", "content": "B1.3"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Exchange information about people's interests and backgrounds using a wider range of language."}, {"type": "secondary_1", "content": "Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. "}, {"type": "secondary_2", "content": "Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. "}, {"type": "secondary_3", "content": "Writes well-organized texts or articles about explaining the rules and regulations in his/her industry using appropriate grammar, vocabulary, spelling coherence and cohesion, and different levels of formality. "}, {"type": "secondary_4", "content": "Writes well-organized texts or articles about explaining the rules and regulations in his/her industry using appropriate grammar, vocabulary, spelling coherence and cohesion, and different levels of formality. "}, {"type": "secondary_5", "content": "Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. "}, {"type": "secondary_6", "content": "Writes well-organized texts or articles about explaining the rules and regulations in his/her industry using appropriate grammar, vocabulary, spelling coherence and cohesion, and different levels of formality. "}, {"type": "secondary_7", "content": "Writes well-organized texts or articles about explaining the rules and regulations in his/her industry using appropriate grammar, vocabulary, spelling coherence and cohesion, and different levels of formality. "}, {"type": "secondary_8", "content": "Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. "}]}, {"type": "background_image", "content": "engenn8le01ob11re1img01.jpg"}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Managing a Conversation"}, {"type": "describer", "content": "It is common to show you understand someone's feelings in a conversation. <br/>You use negative questions to confirm information you already know.<br/>You use <span class=\"italic\">\u201cI wish ...\u201d</span> to talk about things you do not have or do, or you cannot have or do."}, {"type": "text", "content": "Negative questions can have two different meanings. "}, {"type": "text", "content": "You can ask a negative question for confirmation of a positive belief. <br/>You can ask a negative question for confirmation of a negative belief."}, {"type": "text", "content": "Example: <br/><span class=\"italic\">Don't you think I wish things were different for me?</span>"}, {"type": "text", "content": "The verb <span class=\"italic\">wish</span> introduces an idea. After <span class=\"italic\">wish</span>, you use a verb in the past tense."}, {"type": "text", "content": "I wish I knew ...<br/>I wish I had ...<br/>I wish you were \u2026"}, {"type": "text", "content": "Structure: <br/>Wish + Simple Past tense<br/><br/>Example:<br/><span class=\"italic\">I wish it wasn't always the case.</span>"}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Modals For Possibility, Certainty, Suggestions and Expectations"}, {"type": "describer", "content": "You use modals when you want to express possibility, certainty, suggestions and expectations."}, {"type": "text", "content": "<span class=\"strong\">You use may, might and could to express possibility in the past and in the future.</span>"}, {"type": "text", "content": "*Might suggests that something is less possible that may"}, {"type": "text", "content": "<ul><li>might / might not + infinitive</li><li>could / could not + infinitive</li><li>may / may not + infinitive</li></ul>"}, {"type": "text", "content": "Example: "}, {"type": "text", "content": "<span class=\"italic\">She even said that he might be her soulmate.</span>"}, {"type": "text", "content": "<br/><span class=\"strong\">Expressing Certainty</span>"}, {"type": "text", "content": "You use must to express that something is necessarily true."}, {"type": "text", "content": "Example:<br/><span class=\"italic\">The girl of your dreams must be in a comic book store!</span>"}, {"type": "text", "content": "<span class=\"strong\">Should, could, might and would are used to express suggestions:</span>"}, {"type": "text", "content": "Example: <br/><span class=\"italic\">You should keep your eyes open this time.</span>"}, {"type": "text", "content": "<br/>You can also use <span class=\"strong\">supposed to</span> to express expectation."}, {"type": "text", "content": "Example: <br/><span class=\"italic\">I know what you're supposed to do.</span>"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "miserable"}, {"type": "definition", "content": "terrible, awful "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: It made my mother feel miserable. "}, {"type": "audio", "content": "engenn8le01ob11aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": "These are words to review."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "gutsy"}, {"type": "definition", "content": "showing courage and determination"}, {"type": "part_speech", "content": "(adjective"}, {"type": "example", "content": "Example: Going to Italy to meet her boyfriend was very gutsy."}, {"type": "audio", "content": "engenn8le01ob11aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "soulmate"}, {"type": "definition", "content": "a person with whom someone has a deep affinity; life companion"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Don't you think it's wonderful to have a soulmate?"}, {"type": "audio", "content": "engenn8le01ob11aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to have a crush"}, {"type": "definition", "content": "to be infatuated with someone"}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example: Sally told me that Camilla has a crush on me."}, {"type": "audio", "content": "engenn8le01ob11aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "obvious"}, {"type": "definition", "content": "predictable and easily understood"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: I only found out she had a crush on me after Sally pointed out that it was pretty obvious."}, {"type": "audio", "content": "engenn8le01ob11aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "nerd"}, {"type": "definition", "content": "someone obsessively interested in a particular subject "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example:  I'm a comic book nerd. Not all my dates understand that."}, {"type": "audio", "content": "engenn8le01ob11aud06"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "slow on the uptake"}, {"type": "definition", "content": "slow to understand something"}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example: <span class=\"strong\">Mike</span>: You've always been slow on the uptake when it comes to girls, Peter."}, {"type": "audio", "content": "engenn8le01ob11aud07"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "sensible"}, {"type": "definition", "content": "reasonable and wise"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: <span class=\"strong\">Ann</span>: I should hire an assistant manager. <span class=\"strong\">Bob</span>: That sounds like a sensible idea."}, {"type": "audio", "content": "engenn8le01ob11aud08"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "spontaneous"}, {"type": "definition", "content": "natural and genuine"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: If I call Camilla, I won't sound spontaneous."}, {"type": "audio", "content": "engenn8le01ob11aud09"}]}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Brainstorm some common regrets people may have with a partner."}, {"type": "text", "content": "Use negative questions to confirm understanding."}, {"type": "text", "content": "Make sentences using <span class=\"italic\">wish</span> to talk about common regrets."}, {"type": "text", "content": "Make sentences about 5 of your own regrets about dating."}, {"type": "text", "content": "Use <span class=\"italic\">wish</span> to introduce the ideas."}, {"type": "text", "content": "Use <span class=\"italic\">should have</span> and <span class=\"italic\">supposed to</span> for adding details."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I express possibility, certainty, suggestions and expectations."}, {"type": "text", "content": "I encourage agreement and show I understand someone's feelings or situation. "}, {"type": "text", "content": "I reflect on relationships."}]}]}