, "id": 0}], "_data": [{"type": "instructions", "contents": [{"content": "Give dating advice to a friend.", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "allowed_attempts": 2}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Speaking", "type": "skill"}, {"content": "Writing", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self-Assessment.", "type": "text"}]}], "type": "DWS", "template_override": 1}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}]}], "_data": [{"type": "metadata", "contents": [{"content": "The Big Argument", "type": "lesson_name"}, {"content": "Working It Out", "type": "unit_name"}, {"content": 10, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 1, "type": "lesson"}, {"content": "B1.3", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Exchange information about people's interests and backgrounds using a wider range of language.", "type": "primary"}, {"content": "Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_1"}, {"content": "Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_2"}, {"content": "Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_3"}, {"content": "Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_4"}, {"content": "Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_5"}, {"content": "Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_6"}, {"content": "Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_7"}, {"content": "Understands important and specific information and aspects of attitude and intention in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_8"}]}, {"type": "learning_points", "contents": [{"content": "Modals For Possibility, Certainty, Suggestions and Expectations", "type": "heading"}, {"content": "You use modals when you want to express possibility, certainty, suggestions and expectations.", "type": "describer"}, {"content": "You use <span class=\"strong\">might </span> and <span class=\"strong\">could </span> to express <span class=\"underline\">possibility in the past and in the future </span>.  <span class=\"strong\">Can</span> is only used to talk about <span class=\"underline\">possibility in the present and future.</span> ", "type": "text"}, {"content": "Example: <br><span class=\"italic\">I'm sure you <span class=\"strong\">can make</span> it sound spontaneous.<br/>I <span class=\"strong\">can't say</span> I've noticed a big change so far. </span>", "type": "text"}, {"content": "You use <span class=\"strong\">must</span> to express <span class=\"underline\">certainty</span>.", "type": "text"}, {"content": " Example: <br> <span class=\"italic\">There <span class=\"strong\">must</span>  be something you can do about this phobia of yours.</span>", "type": "text"}, {"content": "You use <span class=\"strong\">should</span>  , <span class=\"strong\">could</span>  , <span class=\"strong\">might</span>   and <span class=\"strong\">would</span>  to express <span class=\"underline\">suggestions</span>.", "type": "text"}, {"content": "Example: <br> <span class=\"italic\">You <span class=\"strong\">should</span> call her for me.<br/>You <span class=\"strong\">might</span> want to rehearse for this.<br/>I <span class=\"strong\">could</span> write you a script!</span>", "type": "text"}, {"content": "When you want to express<span class=\"underline\"> expectation</span>, you can use <span class=\"strong\">supposed to</span> .", "type": "text"}, {"content": "Example: <br> <span class=\"italic\">How am I  <span class=\"strong\">supposed to</span> do that?</span>", "type": "text"}]}, {"type": "learning_points", "contents": [{"content": "Negative Questions To Encourage Agreement", "type": "heading"}, {"content": "Negative questions have a different meaning than regular questions.", "type": "describer"}, {"content": "You use negative questions to confirm information you already know. It is another way to keep the conversation going. It is also a more indirect way of letting the other person know that you already know the answer. ", "type": "text"}, {"content": "Look at the chart for some phrases that begin a negative question:", "type": "text"}, {"content": "{\"rows\":6,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Phrase\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Example\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Don't you think ... ?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Don't you think that might work? </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Don't you want ... ?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Don't you want her to know that you've been thinking about her?</span> \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Isn't it true ... ?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Isn't it true that you've been thinking about her for ages?</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Wouldn't you like ... ?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Wouldn't you like to know what she thinks about you?</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Aren't you ... ?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Aren't you curious about what she thinks of you?</span>\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}]}, {"type": "target_word", "contents": [{"content": "to chicken out", "type": "name"}, {"content": "to back out of something at the last minute", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I start dialing the number, but I chicken out before she can answer.", "type": "example"}, {"content": "engenn8le01ob10aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you hear in a conversation about a difficult situation.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "paralyzed", "type": "name"}, {"content": "unable to do anything out of fear", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: I'm paralyzed when it comes to speaking to girls on the phone.", "type": "example"}, {"content": "engenn8le01ob10aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "phobia", "type": "name"}, {"content": "intense fear of something", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: There must be something you can do about your phobia of speaking on the phone.", "type": "example"}, {"content": "engenn8le01ob10aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to mention", "type": "name"}, {"content": "to refer to something without going into detail", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: You could call Camilla and mention the fact that I'd like to go out with her.", "type": "example"}, {"content": "engenn8le01ob10aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "spontaneous", "type": "name"}, {"content": "natural and genuine", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: If I call Camilla, I won't sound spontaneous.", "type": "example"}, {"content": "engenn8le01ob10aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "delivery", "type": "name"}, {"content": "the vocal and bodily behavior during a speech", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Delivery is very important when you read something.", "type": "example"}, {"content": "engenn8le01ob10aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "script", "type": "name"}, {"content": "a written speech, text or play", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: If you don't know what to say, I could write you a script.", "type": "example"}, {"content": "engenn8le01ob10aud07", "type": "audio"}]}, {"content": "engenn8le01ob10re1img01.jpg", "type": "background_image"}, {"type": "takeaway_extension", "contents": [{"content": "Brainstorm ideas on things to do on a first date.", "type": "text"}, {"content": "Write a paragraph giving advice to David, who is going on his first date with a girl he met online.", "type": "text"}, {"content": "What should he do  and what is he supposed to do?", "type": "text"}, {"content": "Include ideas on activities he could do in your community.", "type": "text"}, {"content": "Exchange with a partner and edit each other's paragraphs.", "type": "text"}, {"content": "Add some more ideas about things to do.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I talk about feelings and sensations.", "type": "text"}, {"content": "I talk about things I am supposed to do and things that are supposed to happen.", "type": "text"}, {"content": "I express possibility and certainty.", "type": "text"}]}], "type": "sena"}