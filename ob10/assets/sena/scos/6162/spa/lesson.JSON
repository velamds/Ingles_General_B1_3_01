ata": []}, {"contents": [{"type": "slideshow", "value": {"coverimg": "engenn8le01ob10re2img05.jpg", "audiosrc": "engenn8le01ob10re2aud01", "images": [{"time": "0", "image": "engenn8le01ob10re2img05.jpg", "text": "", "id": 0}, {"time": "100", "image": "engenn8le01ob10re2img05.jpg", "text": "<span class=\"strong\">Sally</span>:\t\tHey, Peter. Did you call Camilla like you said you would?<br/><span class=\"strong\">Peter</span>:\t\tNot yet ... You know me. I start dialing the number, but I chicken out before she can answer. <br/><span class=\"strong\">Sally</span>:\t\tYou're not in high school anymore, Peter! You're supposed to be able to handle this kind of situation, don't you think? <br/><span class=\"strong\">Peter</span>:\t\tI'm just paralyzed when it comes to speaking to girls on the phone.", "id": 1}, {"time": "18500", "image": "engenn8le01ob10re2img01.jpg", "text": "<span class=\"strong\">Sally</span>:\t\tThere must be something you can do about this phobia of yours. Don't you want to let Camilla know that you've been thinking about her? <br/><span class=\"strong\">Peter</span>:\t\tTrust me, I've been trying to work this out. <br/><span class=\"strong\">Sally</span>:\t\tWell, I  can't say I've noticed a big change so far. <br/><span class=\"strong\">Peter</span>:\t\tI have an idea! You could call her for me and mention the fact that I'd like to go out with her sometime!<br/><span class=\"strong\">Sally</span>:\t\tHow am I supposed to do that? It wouldn't sound natural at all.", "id": 2}, {"time": "43500", "image": "engenn8le01ob10re2img05.jpg", "text": "<span class=\"strong\">Peter</span>:\t\tCome on, help me out here! I'm sure you can make it sound spontaneous. You're the writer, not me!<br/><span class=\"strong\">Sally</span>:\t\tHang on ... That's it! I could write you a script! Don't you think that might work? <br/><span class=\"strong\">Peter</span>:\t\tAlright ... So, am I supposed to read it like an actual conversation?<br/><span class=\"strong\">Sally</span>:\t\tOf course! It's all about the delivery! You might want to rehearse for this.", "id": 3}]}}], "template_override": 1, "title": "", "type": "audio", "id": 1, "_data": []}], "id": 0, "_data": [{"type": "lab_options", "contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}]}]}]}